{
    "name": "justinholtweb/craft-eye",
    "description": "Iframes that behave — a smarter embed experience for Craft CMS content: provider-aware embeds, responsive and auto height, lazy and click-to-load, and a guarded proxy for pages that refuse to be framed.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "iframe",
        "embed",
        "oembed",
        "responsive",
        "lazy-loading",
        "proxy"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\eye\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\eye\\tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Eye",
        "handle": "eye",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-eye/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-eye/main/CHANGELOG.md",
        "class": "justinholtweb\\eye\\Plugin"
    }
}
